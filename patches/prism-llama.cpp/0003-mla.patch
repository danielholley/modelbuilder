--- a/src/llama-hparams.cpp
+++ b/src/llama-hparams.cpp
@@ -137,7 +137,16 @@ uint32_t llama_hparams::n_embd_out() const {
     return n_embd_out_impl > 0 ? n_embd_out_impl : n_embd;
 }
 
+uint32_t llama_hparams::mla_cache_width(uint32_t il) const {
+    const uint32_t n_kv  = n_head_kv(il);
+    const uint32_t width = mla_rank[il] + n_kv * (mla_rope_dim + 1);
+    return (width + n_kv - 1) / n_kv;
+}
+
 uint32_t llama_hparams::n_embd_head_k(uint32_t il) const {
+    if (il < n_layer_all && is_mla_layer(il)) {
+        return mla_cache_width(il);
+    }
     if (il < n_layer_all) {
         return is_swa(il) ? n_embd_head_k_swa : n_embd_head_k_full;
     }
@@ -146,6 +155,9 @@ uint32_t llama_hparams::n_embd_head_k(uint32_t il) const {
 }
 
 uint32_t llama_hparams::n_embd_head_v(uint32_t il) const {
+    if (il < n_layer_all && is_mla_layer(il)) {
+        return 1; // V is decompressed from the latent; its cache row is unused
+    }
     if (il < n_layer_all) {
         return is_swa(il) ? n_embd_head_v_swa : n_embd_head_v_full;
     }
diff --git a/src/llama-hparams.h b/src/llama-hparams.h
index d6ea80b..fd41341 100644
--- a/src/llama-hparams.h
+++ b/src/llama-hparams.h
@@ -90,6 +90,18 @@ struct llama_hparams {
     std::array<int32_t, LLAMA_MAX_LAYERS> kv_reuse_layer;
     bool has_kv_reuse() const;
 
+    // multi-head latent attention converted from GQA (modelbuilder surgery mla):
+    // per layer the latent rank (0 = not converted), RoPE dims kept per KV head,
+    // and the kept RoPE frequency indices (in 0 .. n_rot/2). A converted layer
+    // caches [latent | roped weighted RoPE key | ||RoPE key||^2 per head], split
+    // over its KV heads as n_embd_head_k(il) (padded) with a 1-wide V head.
+    std::array<uint32_t, LLAMA_MAX_LAYERS> mla_rank;
+    uint32_t mla_rope_dim = 0;
+    std::array<int32_t, LLAMA_MAX_LAYERS> mla_rope_freqs;
+    uint32_t n_mla_rope_freqs = 0;
+    bool is_mla_layer(uint32_t il) const { return il < LLAMA_MAX_LAYERS && mla_rank[il] > 0; }
+    uint32_t mla_cache_width(uint32_t il) const; // per KV head
+
     // different head size for full_attention and SWA layers
     uint32_t n_embd_head_k_full; // dimension of keys (d_k). d_q is assumed to be the same, but there are n_head q heads, and only n_head_kv k-v heads
     uint32_t n_embd_head_v_full; // dimension of values (d_v) aka n_embd_head
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index fb934ac..939895c 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1489,6 +1489,15 @@ void llama_model_base::load_hparams(llama_model_loader & ml) {
     ml.get_key_or_arr(LLM_KV_FEED_FORWARD_LENGTH,  hparams.n_ff_arr,   hparams.n_layer_all, false);
     ml.get_key_or_arr(LLM_KV_ATTENTION_HEAD_COUNT, hparams.n_head_arr, hparams.n_layer_all, false);
 
+    // Latent attention converted from GQA: 0 = the layer keeps its K/V.
+    std::fill(hparams.mla_rank.begin(), hparams.mla_rank.end(), 0);
+    std::fill(hparams.mla_rope_freqs.begin(), hparams.mla_rope_freqs.end(), -1);
+    if (ml.get_arr(LLM_KV_ATTENTION_MLA_RANK, hparams.mla_rank, false)) {
