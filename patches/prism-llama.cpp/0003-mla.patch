+        ml.get_arr(LLM_KV_ATTENTION_MLA_ROPE_FREQS, hparams.mla_rope_freqs, true);
+        hparams.n_mla_rope_freqs = hparams.mla_rope_dim / 2;
+    }
+
     // Cross-layer KV sharing: -1 = the layer keeps its own cache.
     std::fill(hparams.kv_reuse_layer.begin(), hparams.kv_reuse_layer.end(), -1);
     ml.get_arr(LLM_KV_ATTENTION_KV_REUSE_LAYER, hparams.kv_reuse_layer, false);
