 }
+
+// Latent attention converted from GQA (modelbuilder surgery mla, MHA2MLA).
+// The cache holds, per token, [latent c | rope(k_rope * w_rope) | ||k_rope||^2 per head]:
+// K RMSNorm is a per-(token, head) scale times the weight and RoPE is linear, so the
+// weighted RoPE part can be roped at write time and the norm finished at read time
+// from ||k_rope||^2 and the decompressed nope part. Q is permuted into the cached
+// [rope dims; nope dims] head order (dot products don't change), V comes from kv_b.
+ggml_tensor * llama_model_qwen35::graph::build_layer_attn_mla(
+        llm_graph_input_attn_kv * inp,
+        ggml_tensor *             cur,
+        ggml_tensor *             inp_pos,
+        int *                     sections,
+        int                       il) {
+    const auto & L = model.layers[il];
+
+    const int64_t hd    = hparams.n_embd_head_v();
+    const int64_t n_kvh = hparams.n_head_kv(il);
+    const int64_t rank  = hparams.mla_rank[il];
+    const int64_t rope  = hparams.mla_rope_dim;
+    const int64_t nope  = hd - rope;
+    const int64_t width = rank + n_kvh * (rope + 1);
+    const int64_t W     = hparams.mla_cache_width(il) * n_kvh; // padded
+
+    // queries: projection, Q norm, RoPE on the kept frequencies only, then [rope; nope] order
+    ggml_tensor * Qfull = build_lora_mm(L.wq, cur, L.wq_s);
+    ggml_tensor * Qcur  = ggml_view_3d(ctx0, Qfull, hd, n_head, n_tokens,
+            ggml_element_size(Qfull) * hd * 2, ggml_element_size(Qfull) * hd * 2 * n_head, 0);
+    Qcur = build_norm(Qcur, L.attn_q_norm, nullptr, LLM_NORM_RMS, il);
+    ggml_tensor * gate = ggml_view_3d(ctx0, Qfull, hd, n_head, n_tokens,
+            ggml_element_size(Qfull) * hd * 2, ggml_element_size(Qfull) * hd * 2 * n_head,
+            ggml_element_size(Qfull) * hd);
+    gate = ggml_cont_2d(ctx0, gate, hd * n_head, n_tokens);
+    Qcur = ggml_rope_multi(ctx0, Qcur, inp_pos, L.mla_ff_q,
+            n_rot, sections, rope_type, n_ctx_orig, freq_base, freq_scale,
+            ext_factor, attn_factor, beta_fast, beta_slow);
+    Qcur = ggml_mul_mat(ctx0, L.mla_perm, ggml_reshape_2d(ctx0, ggml_cont(ctx0, Qcur), hd, n_head * n_tokens));
+    Qcur = ggml_reshape_3d(ctx0, Qcur, hd, n_head, n_tokens);
+    cb(Qcur, "mla_Qcur", il);
+
+    // the cached row for the new tokens
+    ggml_tensor * c   = build_lora_mm(L.mla_kv_a, cur);                                      // [rank, T]
+    ggml_tensor * kr  = ggml_reshape_3d(ctx0, build_lora_mm(L.mla_k_rope, cur), rope, n_kvh, n_tokens);
+    ggml_tensor * n2  = ggml_sum_rows(ctx0, ggml_sqr(ctx0, kr));                              // [1, n_kvh, T]
+    ggml_tensor * krw = ggml_mul(ctx0, kr, L.mla_k_rope_norm);
+    ggml_tensor * pos = ggml_view_1d(ctx0, inp_pos, n_tokens, 0);                             // text: one position per token
+    ggml_tensor * krr = ggml_rope_ext(ctx0, krw, pos, L.mla_ff_k,
+            rope, LLAMA_ROPE_TYPE_NEOX, n_ctx_orig, freq_base, freq_scale,
+            ext_factor, attn_factor, beta_fast, beta_slow);
+    ggml_tensor * row = ggml_concat(ctx0, c, ggml_reshape_2d(ctx0, ggml_cont(ctx0, krr), rope * n_kvh, n_tokens), 0);
+    row = ggml_concat(ctx0, row, ggml_reshape_2d(ctx0, n2, n_kvh, n_tokens), 0);
+    if (W > width) {
+        row = ggml_pad(ctx0, row, W - width, 0, 0, 0);
+    }
+    cb(row, "mla_cache_row", il);
+
+    const auto * mctx = inp->mctx;
+    ggml_build_forward_expand(gf, mctx->cpy_k(ctx0, ggml_reshape_3d(ctx0, row, W / n_kvh, n_kvh, n_tokens),
+                                              inp->get_k_idxs(), il));
+    // the layer's V cache row is 1 wide and unused; writing zeros keeps the
+    // cache's V inputs in the graph like any other layer's
+    ggml_tensor * v_zero = ggml_scale(ctx0, ggml_cont(ctx0, ggml_view_3d(ctx0, c, 1, n_kvh, n_tokens,
+            ggml_element_size(c), c->nb[1], 0)), 0.0f);
+    ggml_build_forward_expand(gf, mctx->cpy_v(ctx0, v_zero, inp->get_v_idxs(), il));
+
+    // every cached position: decompress K and V
+    ggml_tensor * kc   = mctx->get_k(ctx0, il);                                               // [W/n_kvh, n_kvh, n_kv, n_stream]
+    const int64_t n_kv = kc->ne[2];
+    const int64_t ns   = kc->ne[3];
+    const size_t  es   = ggml_element_size(kc);
+    const size_t  rs   = kc->nb[2];
+    const size_t  ss   = kc->nb[3];
+    auto f32 = [&](ggml_tensor * t) { return ggml_cast(ctx0, ggml_cont(ctx0, t), GGML_TYPE_F32); };
+    ggml_tensor * c_all   = f32(ggml_view_3d(ctx0, kc, rank, n_kv, ns, rs, ss, 0));
+    ggml_tensor * krr_all = f32(ggml_view_4d(ctx0, kc, rope, n_kvh, n_kv, ns, es * rope, rs, ss, es * rank));
+    ggml_tensor * n2_all  = f32(ggml_view_4d(ctx0, kc, 1, n_kvh, n_kv, ns, es, rs, ss, es * (rank + n_kvh * rope)));
+
+    ggml_tensor * kvb = ggml_mul_mat(ctx0, L.mla_kv_b, c_all);                                // [n_kvh*nope + n_kvh*hd, n_kv, ns]
+    const size_t  fs  = ggml_element_size(kvb);
+    ggml_tensor * kn  = ggml_cont(ctx0, ggml_view_4d(ctx0, kvb, nope, n_kvh, n_kv, ns,
+            fs * nope, kvb->nb[1], kvb->nb[2], 0));
+    ggml_tensor * V   = ggml_cont(ctx0, ggml_view_4d(ctx0, kvb, hd, n_kvh, n_kv, ns,
+            fs * hd, kvb->nb[1], kvb->nb[2], fs * n_kvh * nope));
+
+    // K RMSNorm over the whole head: 1/sqrt((||k_rope||^2 + ||k_nope||^2)/hd + eps)
+    ggml_tensor * ms = ggml_scale_bias(ctx0, ggml_add(ctx0, n2_all, ggml_sum_rows(ctx0, ggml_sqr(ctx0, kn))),
+            1.0f / (float) hd, hparams.f_norm_rms_eps);
+    ggml_tensor * K  = ggml_concat(ctx0, krr_all, ggml_mul(ctx0, kn, L.mla_k_nope_norm), 0);  // [hd, n_kvh, n_kv, ns]
+    K = ggml_div(ctx0, K, ggml_sqrt(ctx0, ms));
+    cb(K, "mla_K", il);
+
+    const float kq_scale = hparams.f_attention_scale == 0.0f ? 1.0f / sqrtf(float(hd)) : hparams.f_attention_scale;
+    cur = build_attn_mha(Qcur, K, V, nullptr, inp->get_kq_mask(), nullptr, nullptr, 0, kq_scale, il);
+    cb(cur, "mla_attn", il);
+
+    cur = ggml_mul(ctx0, cur, ggml_sigmoid(ctx0, gate));
+    return build_lora_mm(L.wo, cur, L.wo_s);
+}
