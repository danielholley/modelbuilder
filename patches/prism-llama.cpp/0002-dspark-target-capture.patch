+int32_t llama_model_dspark_get_target_layers(const llama_model * model, int32_t * out, int32_t n_max) {
+    if (model == nullptr || model->hparams.dspark_block_size == 0) {
+        return 0;
+    }
+    const auto & hp = model->hparams;
+    for (uint32_t i = 0; i < hp.n_dspark_target_layers && (int32_t) i < n_max; ++i) {
+        out[i] = (int32_t) hp.dspark_target_layers[i];
+    }
+    return (int32_t) hp.n_dspark_target_layers;
