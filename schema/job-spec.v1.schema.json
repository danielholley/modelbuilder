{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielholley/modelbuilder/schema/job-spec.v1.schema.json",
  "title": "modelbuilder training job spec, version 1",
  "description": "Written by the Rust side (mb-jobs), read by the Python side (modelbuilder_train). Paths are absolute or relative to the spec file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "backend",
    "device",
    "output_dir",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string"
    },
    "backend": {
      "enum": [
        "torch",
        "mlx"
      ],
      "description": "torch runs every stage kind; mlx runs mtp_align on Apple Silicon."
    },
    "device": {
      "enum": [
        "auto",
        "cpu",
        "cuda",
        "mps"
      ]
    },
    "hardware_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "hyper"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "mtp_align",
            "trunk_distill",
            "draft_align"
          ]
        },
        "mtp_align": {
          "$ref": "#/$defs/mtp_align"
        },
        "hyper": {
          "$ref": "#/$defs/hyper"
        },
        "trunk_distill": {
          "$ref": "#/$defs/trunk_distill"
        },
        "draft_align": {
          "$ref": "#/$defs/draft_align"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mtp_align"
              }
            }
          },
          "then": {
            "required": [
              "mtp_align"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "trunk_distill"
              }
            }
          },
          "then": {
            "required": [
              "trunk_distill"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "draft_align"
              }
            }
          },
          "then": {
            "required": [
              "draft_align"
            ]
          }
        }
      ]
    },
    "mtp_align": {
      "description": "Train an MTP head against a frozen trunk from precomputed trunk hidden states.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_config",
        "frozen_tensors",
        "embedding_tensor",
        "lm_head_tensor",
        "features"
      ],
      "properties": {
        "reference_config": {
          "type": "string",
          "description": "HF config.json giving the head's shapes (e.g. the base model the head is ported from)."
        },
        "init_head": {
          "type": [
            "string",
            "null"
          ],
          "description": "Directory or file with mtp.* tensors to start from; null for random init."
        },
        "frozen_tensors": {
          "type": "string",
          "description": "safetensors with the target's token embedding and output head in the primal basis (modelbuilder export-tensors)."
        },
        "embedding_tensor": {
          "type": "string"
        },
        "lm_head_tensor": {
          "type": "string"
        },
        "features": {
          "type": "string",
          "description": "Feature directory (manifest.json + shards) from modelbuilder_train extract-features."
        },
        "eval_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.05
        }
      }
    },
    "hyper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lr",
        "steps",
        "seq_len",
        "batch_seqs"
      ],
      "properties": {
        "lr": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "seq_len": {
          "type": "integer",
          "minimum": 4
        },
        "batch_seqs": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_steps": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "weight_decay": {
          "type": "number",
          "minimum": 0,
          "default": 0.0
        },
        "grad_clip": {
          "type": [
            "number",
            "null"
          ],
          "default": 1.0
        },
        "log_every": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "eval_every": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "seed": {
          "type": "integer",
          "default": 0
        },
        "dtype": {
          "enum": [
            "float32",
            "bfloat16"
          ],
          "default": "float32"
        }
      }
    },
    "trunk_distill": {
      "description": "Retrain selected trunk tensors so a modified model (quantized KV cache, shared KV, fake-quantized weights, MLA, removed layers) matches the original by KL on next-token distributions, or train them on next-token cross-entropy.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "texts",
        "trainable"
      ],
      "properties": {
        "model": {
          "type": "string",
          "description": "HF model directory, e.g. from modelbuilder export-hf (with modelbuilder_quantization.json for weight fake-quantization)."
        },
        "texts": {
          "type": "string",
          "description": "JSONL with {\"text\": ...} or {\"tokens\": [...]} per line."
        },
        "trainable": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Parameter-name substrings to train, e.g. self_attn.k_proj.weight."
        },
        "kv_format": {
          "enum": [
            "q8_0",
            "q4_0",
            "nvfp4",
            null
          ],
          "description": "Fake-quantize the KV cache to this format."
        },
        "kv_share_group": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2,
          "description": "Share K/V across groups of this many consecutive attention layers."
        },
        "weight_fakequant": {
          "type": "boolean",
          "default": true
        },
        "teacher": {
          "type": [
            "string",
            "null"
          ],
          "description": "A separate HF checkpoint to distill from (e.g. the unpruned or unmodified original). Default: the model itself with every modification switched off."
        },
        "loss": {
          "enum": [
            "kl",
            "ce"
          ],
          "default": "kl",
          "description": "kl: KL to the teacher's next-token distribution; ce: next-token cross-entropy on the texts (no teacher), e.g. a long-context finetune."
        },
        "device_map": {
          "enum": [
            "auto",
            "balanced",
            "sequential",
            null
          ],
          "description": "Spread the model (and a teacher) layer by layer over this process's GPUs (transformers/accelerate device_map), for models that don't fit on one."
        },
        "shard": {
          "enum": [
            "fsdp",
            null
          ],
          "description": "Shard each decoder layer over the torchrun processes (FSDP2), on one or more machines. Needs loss ce or a separate teacher, no lora_rank, weight_fakequant false."
        },
        "lora_rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Train a rank-r LoRA update of each trainable tensor instead of the tensor itself; it is merged (and fake-quantized) before write-back."
        },
        "lora_alpha": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "LoRA scale numerator: the update is (alpha / rank)·B·A. Default: rank (scale 1)."
        },
        "eval_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.05
        }
      }
    },
    "draft_align": {
      "description": "Train a speculative-decoding drafter against a frozen target: Medusa or EAGLE from precomputed trunk hidden states, or DSpark (DeepSeek's DeepSpec) with the target online.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "medusa",
            "eagle",
            "dspark"
          ]
        },
        "heads": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "Medusa: number of heads (head k predicts token t+k+1)."
        },
        "blocks": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "EAGLE / DSpark: decoder layers."
        },
        "share_lm_head": {
          "type": "boolean",
          "default": false,
          "description": "Medusa: reuse the frozen LM head instead of a trainable copy per head."
        },
        "reference_config": {
          "type": [
            "string",
            "null"
          ],
          "description": "EAGLE (required): the target's HF config.json, for the decoder layer's shape."
        },
        "frozen_tensors": {
          "type": [
            "string",
            "null"
          ],
          "description": "safetensors with the target's token embedding and output head in the primal basis (modelbuilder export-tensors)."
        },
        "embedding_tensor": {
          "type": [
            "string",
            "null"
          ]
        },
        "lm_head_tensor": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": [
            "string",
            "null"
          ],
          "description": "Feature directory from modelbuilder_train extract-features."
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "DSpark: HF directory of the target (e.g. from modelbuilder export-hf); it runs online for the tapped hidden states."
        },
        "texts": {
          "type": [
            "string",
            "null"
          ],
          "description": "DSpark: JSONL with {\"text\": ...} or {\"tokens\": [...]} per line."
        },
        "block_size": {
          "type": "integer",
          "minimum": 2,
          "default": 7
        },
        "target_layer_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": -1
          },
          "description": "DSpark: target layers to tap (-1: the embedding); default five spread evenly."
        },
        "mask_token_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "DSpark: a token id the tokenizer never produces; default the last embedding row."
        },
        "markov_rank": {
          "type": "integer",
          "minimum": 0,
          "default": 256
        },
        "num_anchors": {
          "type": "integer",
          "minimum": 1,
          "default": 512
        },
        "confidence_head": {
          "type": "boolean",
          "default": true
        },
        "eval_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.05
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "eagle"
              }
            }
          },
          "then": {
            "required": [
              "reference_config"
            ],
            "properties": {
              "reference_config": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "medusa",
                  "eagle"
                ]
              }
            }
          },
          "then": {
            "required": [
              "frozen_tensors",
              "embedding_tensor",
              "lm_head_tensor",
              "features"
            ],
            "properties": {
              "frozen_tensors": {
                "type": "string"
              },
              "embedding_tensor": {
                "type": "string"
              },
              "lm_head_tensor": {
                "type": "string"
              },
              "features": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dspark"
              }
            }
          },
          "then": {
            "required": [
              "target",
              "texts"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "texts": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
